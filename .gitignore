# Assinatura Android — NUNCA versionar.
# Perder este keystore significa não conseguir mais publicar atualizações
# do app na Play Store sob o mesmo pacote. Guarde uma cópia em local seguro.
app/android/key.properties
app/android/*.jks
app/android/*.keystore
dist/
